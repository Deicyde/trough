// The site's home: a Cloudflare Worker that serves the files mkdocs builds into
// site/, as WikiLean's Worker serves its own. A deploy uploads only the files
// that changed. The Pages workflow's cloudflare job deploys it from main.
{
  "name": "trough",
  "main": "worker.js",
  "compatibility_date": "2026-11-11",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    // Every file is served exactly at its own address, foo.html at /foo.html, as
    // GitHub Pages served it. AutoformBot's reader fetches an article's .html
    // address and checks the page's own link against the address it got, so the
    // default redirect from /foo.html to /foo made it report a loop. An address
    // that names no file, such as a folder's, goes to worker.js.
    "html_handling": "none"
  },
  "routes": [{ "pattern": "trough.jackmccarthy.org", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
