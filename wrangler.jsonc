// The site's home: a Cloudflare Worker that only serves the files mkdocs builds
// into site/, as WikiLean's Worker serves its own. A deploy uploads only the
// files that changed. The Pages workflow's cloudflare job deploys it from main.
{
  "name": "trough",
  "compatibility_date": "2026-11-11",
  "assets": {
    "directory": "./site",
    // A folder's index.html is served at the folder with a trailing slash, so
    // the site's relative links resolve as they did on GitHub Pages; foo.html
    // is served at /foo.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "trough.jackmccarthy.org", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
